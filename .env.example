# ===== サーバー共通 =====
NODE_ENV=development
PORT=3001
# ブラウザ/デスクトップアプリからの接続を許可するオリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost
# 32文字以上のランダム文字列（openssl rand -base64 48 で生成）
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=604800

# ===== データベース =====
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379

# ===== フェーズ2: ファイル共有（Cloudflare R2 / S3互換） =====
# R2 の場合: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=nexus-files
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO は true、R2 は false
S3_FORCE_PATH_STYLE=true
# 1ファイルの上限（バイト）。既定 50GB
MAX_UPLOAD_BYTES=53687091200

# ===== フェーズ2: 全文検索（Meilisearch） =====
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me-0123456789

# ===== フェーズ2: AI（Vercel AI SDK + Anthropic） =====
# 未設定の場合、AI機能は「未設定」エラーを返し、他の機能は通常どおり動きます
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=claude-opus-5-5
AI_TRANSLATE_MODEL=claude-opus-5-5

# ===== フェーズ3: 音声・ビデオ（LiveKit） =====
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ===== フロントエンド（apps/web/.env に置く） =====
# Web版は空のままでOK（Vite の proxy を使う）。デスクトップ版はサーバーの絶対URLを指定
VITE_API_URL=
