{
  "name": "nexus",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @nexus/server\" \"npm run dev -w @nexus/web\"",
    "dev:server": "npm run dev -w @nexus/server",
    "dev:web": "npm run dev -w @nexus/web",
    "build": "npm run build -w @nexus/shared && npm run build -w @nexus/server && npm run build -w @nexus/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @nexus/server",
    "db:migrate": "npm run db:migrate -w @nexus/server",
    "tauri:dev": "npm run tauri:dev -w @nexus/web",
    "tauri:build": "npm run tauri:build -w @nexus/web",
    "test": "node scripts/smoke-test.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^5.9.3"
  }
}
