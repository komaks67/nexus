{
  "name": "@nexus/server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/db/migrate.ts",
    "search:reindex": "tsx --conditions=development --env-file-if-exists=../../.env src/services/reindex.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.108",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "@nexus/shared": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "ai": "^7.0.181",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22",
    "ioredis": "^6.1.0",
    "livekit-server-sdk": "^2.20.1",
    "meilisearch": "^0.63.0",
    "postgres": "^4.1.1",
    "socket.io": "^4.8.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
